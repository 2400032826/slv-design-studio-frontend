# Frontend Environment Variables
# Copy this to .env in the frontend folder

# Backend API URL (Default: Render Production Backend)
VITE_API_URL=https://slv-design-studio-backend.onrender.com/api

# Razorpay public key (safe to expose - this is the public KEY, not secret)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# App Name
VITE_APP_NAME=SLV Design Studio
